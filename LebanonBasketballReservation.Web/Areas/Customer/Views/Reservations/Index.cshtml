@model LebanonBasketballReservation.Web.ViewModels.Reservation.ReservationListViewModel
@{ ViewData["Title"] = "My reservations"; }

<div class="container py-4">
    <h1 class="h4 fw-bold mb-4"><i class="bi bi-calendar3 text-brand me-2"></i>My reservations</h1>

    @if (Model.IsEmpty)
    {
        <div class="card border-0 shadow-sm">
            <partial name="_EmptyState" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.EmptyStateModel
                     {
                         Icon = "bi-calendar-plus",
                         Title = "No reservations yet",
                         Message = "Find a court and book your first slot.",
                         ActionText = "Find stadiums",
                         ActionUrl = Url.Action("Index", "Stadiums", new { area = "" }),
                         ActionIcon = "bi-search"
                     })" />
        </div>
    }
    else
    {
        @if (Model.Upcoming.Count > 0)
        {
            <h2 class="h6 fw-semibold text-muted mb-2">Upcoming</h2>
            <div class="card border-0 shadow-sm mb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Stadium / court</th>
                                <th>When</th>
                                <th class="text-end">Price</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Upcoming)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r.StadiumName</div>
                                        <div class="small text-muted">@r.CourtName</div>
                                    </td>
                                    <td class="small">
                                        @r.Date.ToString("ddd dd MMM yyyy")<br />
                                        <span class="text-muted">@r.StartTime.ToString("HH\\:mm") – @r.EndTime.ToString("HH\\:mm")</span>
                                    </td>
                                    <td class="text-end fw-semibold">$@r.TotalPrice.ToString("N2")</td>
                                    <td><partial name="_StatusBadge" model="@r.Status" /></td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>
                                        @if (r.CanCancel)
                                        {
                                            <a asp-action="Cancel" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">
                                                Cancel
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.Past.Count > 0)
        {
            <h2 class="h6 fw-semibold text-muted mb-2">History</h2>
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Stadium / court</th>
                                <th>When</th>
                                <th class="text-end">Price</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Past)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r.StadiumName</div>
                                        <div class="small text-muted">@r.CourtName</div>
                                    </td>
                                    <td class="small">
                                        @r.Date.ToString("dd MMM yyyy")<br />
                                        <span class="text-muted">@r.StartTime.ToString("HH\\:mm") – @r.EndTime.ToString("HH\\:mm")</span>
                                    </td>
                                    <td class="text-end">$@r.TotalPrice.ToString("N2")</td>
                                    <td><partial name="_StatusBadge" model="@r.Status" /></td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>
                                        @if (r.CanReview)
                                        {
                                            <a asp-controller="Reviews" asp-action="Create" asp-route-reservationId="@r.Id"
                                               class="btn btn-sm btn-brand">
                                                <i class="bi bi-star me-1"></i>Review
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
