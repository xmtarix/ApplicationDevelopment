@model LebanonBasketballReservation.Web.ViewModels.Reservation.CreateReservationViewModel
@{ ViewData["Title"] = "Book a court"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h4 fw-bold mb-3">Book a court</h1>

            @if (Model.Stadium is not null && Model.Court is not null)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h6 fw-bold mb-1">@Model.Stadium.Name — @Model.Court.Name</h2>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt me-1"></i>@Model.Stadium.Address, @Model.Stadium.FullLocation
                        </p>
                        <p class="mb-0 fw-semibold text-brand">
                            $@Model.Court.HourlyPrice.ToString("0.##") <span class="text-muted fw-normal small">/ hour</span>
                        </p>
                    </div>
                </div>
            }

            <form asp-action="Create" method="post" data-price-form
                  data-hourly-price="@(Model.Court?.HourlyPrice ?? 0)">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>

                <input type="hidden" asp-for="CourtId" />
                <input type="hidden" asp-for="StadiumId" />

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold">Choose a time slot</div>
                    <div class="card-body">
                        @if (!Model.Calendar.Any())
                        {
                            <p class="text-muted mb-0">
                                No open slots in the next two weeks. Please check back later or pick another court.
                            </p>
                        }
                        else
                        {
                            @foreach (var day in Model.Calendar)
                            {
                                <div class="mb-3">
                                    <p class="small fw-semibold mb-2">
                                        @day.Date.ToString("dddd, dd MMM yyyy")
                                        <span class="text-muted fw-normal">(@day.Count open)</span>
                                    </p>
                                    <div class="slot-grid">
                                        @foreach (var slot in day.Slots)
                                        {
                                            <span class="slot-option">
                                                <input type="radio" name="TimeSlotId" id="slot-@slot.Id"
                                                       value="@slot.Id" data-hours="@slot.DurationHours"
                                                       checked="@(Model.TimeSlotId == slot.Id)" />
                                                <label for="slot-@slot.Id">@slot.Label</label>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <label asp-for="Notes" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Anything the manager should know?"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Total</span>
                        <span class="h5 mb-0 text-brand fw-bold" data-price-output>—</span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand" data-price-submit>
                        <i class="bi bi-check2-circle me-1"></i>Confirm booking
                    </button>
                    <a asp-controller="Stadiums" asp-action="Details" asp-route-id="@Model.StadiumId" asp-area=""
                       class="btn btn-outline-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
