@model IEnumerable<LebanonBasketballReservation.Business.DTOs.NotificationDto>
@{
    ViewData["Title"] = "Notifications";
    var items = Model.ToList();
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="h4 fw-bold mb-0"><i class="bi bi-bell text-brand me-2"></i>Notifications</h1>
        @if (items.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllRead" method="post">
                <button class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-check2-all me-1"></i>Mark all read
                </button>
            </form>
        }
    </div>

    @if (items.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <partial name="_EmptyState" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.EmptyStateModel
                     {
                         Icon = "bi-bell-slash",
                         Title = "No notifications yet",
                         Message = "Booking updates and reminders will appear here."
                     })" />
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="list-group list-group-flush">
                @foreach (var n in items)
                {
                    <div class="list-group-item @(n.IsRead ? "" : "bg-brand-light")">
                        <div class="d-flex gap-3">
                            <div class="@n.ColorClass fs-5"><i class="bi @n.Icon"></i></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <strong>@n.Title</strong>
                                    <small class="text-muted text-nowrap">@n.CreatedAt.ToString("dd MMM, HH:mm")</small>
                                </div>
                                <p class="mb-2 small">@n.Message</p>
                                <div class="d-flex gap-2">
                                    @if (!n.IsRead)
                                    {
                                        <form asp-action="MarkRead" method="post">
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button class="btn btn-sm btn-link p-0 text-decoration-none">Mark read</button>
                                        </form>
                                    }
                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button class="btn btn-sm btn-link p-0 text-decoration-none text-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
