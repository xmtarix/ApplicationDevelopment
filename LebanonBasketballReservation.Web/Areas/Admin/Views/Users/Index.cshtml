@using LebanonBasketballReservation.Data
@model LebanonBasketballReservation.Web.ViewModels.Admin.UserListViewModel
@{ ViewData["Title"] = "Users"; }

<div class="container-fluid py-4">
    <h1 class="h4 fw-bold mb-3"><i class="bi bi-people text-brand me-2"></i>Users</h1>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Search</label>
                    <input name="search" value="@Model.Search" class="form-control form-control-sm"
                           placeholder="Name or email…" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Role</label>
                    <select name="role" class="form-select form-select-sm">
                        <option value="">All roles</option>
                        @foreach (var r in RoleNames.All)
                        {
                            <option value="@r" selected="@(Model.Role == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button class="btn btn-sm btn-brand"><i class="bi bi-funnel me-1"></i>Filter</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <partial name="_EmptyState" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.EmptyStateModel
                     {
                         Icon = "bi-people",
                         Title = "No users found",
                         Message = "Try a different search or role filter."
                     })" />
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Joined</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-circle">@u.Initials</span>
                                        <span class="fw-semibold">@u.FullName</span>
                                    </div>
                                </td>
                                <td class="small">
                                    @u.Email
                                    @if (!string.IsNullOrEmpty(u.PhoneNumber))
                                    {
                                        <br /><span class="text-muted">@u.PhoneNumber</span>
                                    }
                                </td>
                                <td>
                                    @foreach (var role in u.Roles)
                                    {
                                        <span class="badge bg-light text-dark border me-1">@role</span>
                                    }
                                </td>
                                <td class="small text-muted">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Deactivated</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleActive" method="post"
                                          data-confirm="@(u.IsActive ? $"Deactivate {u.FullName}? They will be signed out and unable to log in." : $"Reactivate {u.FullName}?")">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check") me-1"></i>
                                            @(u.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <partial name="_Pager" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.PagerModel
                 {
                     Page = Model.Page,
                     TotalPages = Model.TotalPages,
                     RouteValues = new Dictionary<string, string?>
                     {
                         ["search"] = Model.Search,
                         ["role"] = Model.Role
                     }
                 })" />
    }
</div>
