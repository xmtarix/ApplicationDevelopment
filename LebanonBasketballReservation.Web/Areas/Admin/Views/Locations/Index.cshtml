@model IEnumerable<LebanonBasketballReservation.Business.DTOs.GovernorateTreeDto>
@{
    ViewData["Title"] = "Locations";
    var governorates = Model.ToList();
}

<div class="container py-4">
    <h1 class="h4 fw-bold mb-4"><i class="bi bi-geo-alt text-brand me-2"></i>Locations</h1>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Add a governorate</div>
        <div class="card-body">
            <form asp-action="CreateGovernorate" method="post" class="row g-2">
                <div class="col-md-5">
                    <input name="name" class="form-control form-control-sm" placeholder="Name (English)" required maxlength="100" />
                </div>
                <div class="col-md-5">
                    <input name="nameAr" class="form-control form-control-sm" placeholder="الاسم بالعربية" maxlength="100" />
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-sm btn-brand"><i class="bi bi-plus-lg me-1"></i>Add</button>
                </div>
            </form>
        </div>
    </div>

    @if (governorates.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <partial name="_EmptyState" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.EmptyStateModel
                     {
                         Icon = "bi-geo-alt",
                         Title = "No locations yet",
                         Message = "Add a governorate above to start building the hierarchy."
                     })" />
        </div>
    }
    else
    {
        <div class="accordion" id="locationTree">
            @foreach (var gov in governorates)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#gov-@gov.Id">
                            <span class="fw-semibold">@gov.Name</span>
                            <span class="text-muted small ms-2">
                                @gov.Districts.Count district@(gov.Districts.Count == 1 ? "" : "s")
                                · @gov.AreaCount area@(gov.AreaCount == 1 ? "" : "s")
                                · @gov.StadiumCount stadium@(gov.StadiumCount == 1 ? "" : "s")
                            </span>
                        </button>
                    </h2>
                    <div id="gov-@gov.Id" class="accordion-collapse collapse" data-bs-parent="#locationTree">
                        <div class="accordion-body">
                            <div class="d-flex justify-content-end mb-3">
                                <form asp-action="DeleteGovernorate" method="post"
                                      data-confirm="Delete governorate &quot;@gov.Name&quot;?">
                                    <input type="hidden" name="id" value="@gov.Id" />
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Delete governorate
                                    </button>
                                </form>
                            </div>

                            <form asp-action="CreateDistrict" method="post" class="row g-2 mb-3">
                                <input type="hidden" name="governorateId" value="@gov.Id" />
                                <div class="col-md-5">
                                    <input name="name" class="form-control form-control-sm"
                                           placeholder="New district name" required maxlength="100" />
                                </div>
                                <div class="col-md-5">
                                    <input name="nameAr" class="form-control form-control-sm"
                                           placeholder="الاسم بالعربية" maxlength="100" />
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button class="btn btn-sm btn-outline-brand">Add district</button>
                                </div>
                            </form>

                            @if (gov.Districts.Count == 0)
                            {
                                <p class="text-muted small mb-0">No districts in this governorate yet.</p>
                            }
                            else
                            {
                                foreach (var dist in gov.Districts)
                                {
                                    <div class="border rounded p-3 mb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <strong>@dist.Name</strong>
                                                <span class="text-muted small ms-2">
                                                    @dist.Areas.Count area@(dist.Areas.Count == 1 ? "" : "s")
                                                </span>
                                            </div>
                                            <form asp-action="DeleteDistrict" method="post"
                                                  data-confirm="Delete district &quot;@dist.Name&quot;?">
                                                <input type="hidden" name="id" value="@dist.Id" />
                                                <button class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>

                                        <form asp-action="CreateArea" method="post" class="row g-2 mb-2">
                                            <input type="hidden" name="districtId" value="@dist.Id" />
                                            <div class="col-md-5">
                                                <input name="name" class="form-control form-control-sm"
                                                       placeholder="New area name" required maxlength="100" />
                                            </div>
                                            <div class="col-md-5">
                                                <input name="nameAr" class="form-control form-control-sm"
                                                       placeholder="الاسم بالعربية" maxlength="100" />
                                            </div>
                                            <div class="col-md-2 d-grid">
                                                <button class="btn btn-sm btn-outline-secondary">Add area</button>
                                            </div>
                                        </form>

                                        @if (dist.Areas.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var area in dist.Areas)
                                                {
                                                    <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                                        @area.Name
                                                        @if (area.StadiumCount > 0)
                                                        {
                                                            <span class="text-muted">(@area.StadiumCount)</span>
                                                        }
                                                        <form asp-action="DeleteArea" method="post" class="d-inline"
                                                              data-confirm="Delete area &quot;@area.Name&quot;?">
                                                            <input type="hidden" name="id" value="@area.Id" />
                                                            <button class="btn btn-sm btn-link p-0 text-danger lh-1"
                                                                    title="Delete area">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        </form>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
