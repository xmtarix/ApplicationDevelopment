@using LebanonBasketballReservation.Data.Enums
@model LebanonBasketballReservation.Business.DTOs.StadiumDto
@{ ViewData["Title"] = Model.Name; }

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Admin</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Stadiums</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="stadium-hero">
                    @if (!string.IsNullOrEmpty(Model.MainImagePath))
                    {
                        <img src="@Model.MainImagePath" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="stadium-thumb-placeholder"><i class="bi bi-building"></i></div>
                    }
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div>
                            <h1 class="h4 fw-bold mb-1">@Model.Name</h1>
                            <p class="text-muted small mb-0">
                                <i class="bi bi-geo-alt me-1"></i>@Model.Address, @Model.FullLocation
                            </p>
                        </div>
                        @{
                            var badge = Model.Status switch
                            {
                                StadiumStatus.Active => "bg-success",
                                StadiumStatus.Pending => "bg-warning text-dark",
                                StadiumStatus.Rejected => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badge">@Model.Status</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="mt-3 mb-0">@Model.Description</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Courts (@Model.CourtCount)</div>
                @if (!Model.Courts.Any())
                {
                    <div class="card-body text-muted text-center py-4">No courts added yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Court</th>
                                    <th>Type</th>
                                    <th class="text-center">Capacity</th>
                                    <th class="text-end">Price/hr</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Courts)
                                {
                                    <tr>
                                        <td class="fw-semibold">@c.Name</td>
                                        <td><span class="badge @(c.IsIndoor ? "bg-primary" : "bg-success")">@c.TypeLabel</span></td>
                                        <td class="text-center">@c.Capacity</td>
                                        <td class="text-end">$@c.HourlyPrice.ToString("0.##")</td>
                                        <td><span class="badge bg-light text-dark border">@c.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold">Manager</div>
                <div class="card-body">
                    <p class="mb-1 fw-semibold">@Model.ManagerName</p>
                    @if (!string.IsNullOrEmpty(Model.ManagerEmail))
                    {
                        <p class="small text-muted mb-1">
                            <i class="bi bi-envelope me-1"></i>@Model.ManagerEmail
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <p class="small text-muted mb-0">
                            <i class="bi bi-telephone me-1"></i>@Model.Phone
                        </p>
                    }
                </div>
            </div>

            @if (Model.Status == StadiumStatus.Pending)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white fw-semibold">Review</div>
                    <div class="card-body d-grid gap-2">
                        <form asp-action="Approve" method="post" data-confirm="Approve this stadium?">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnAction" value="Index" />
                            <button class="btn btn-success w-100">
                                <i class="bi bi-check2 me-1"></i>Approve
                            </button>
                        </form>
                        <form asp-action="Reject" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnAction" value="Index" />
                            <input name="reason" class="form-control form-control-sm mb-2"
                                   placeholder="Reason (optional)" maxlength="500" />
                            <button class="btn btn-outline-danger w-100">
                                <i class="bi bi-x me-1"></i>Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
