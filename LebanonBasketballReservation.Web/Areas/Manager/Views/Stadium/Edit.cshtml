@model LebanonBasketballReservation.Web.ViewModels.Stadium.CreateStadiumViewModel
@{ ViewData["Title"] = "Edit stadium"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h4 fw-bold mb-4">Edit @Model.Name</h1>

            <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                <partial name="_StadiumForm" model="Model" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand">
                        <i class="bi bi-check2 me-1"></i>Save changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
