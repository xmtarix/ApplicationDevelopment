@model LebanonBasketballReservation.Business.DTOs.CreateCourtDto
@{
    ViewData["Title"] = "Add court";
    var stadiumName = ViewData["StadiumName"] as string;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="h4 fw-bold mb-1">Add a court</h1>
            @if (!string.IsNullOrEmpty(stadiumName))
            {
                <p class="text-muted small mb-4">at @stadiumName</p>
            }

            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
                <input type="hidden" asp-for="StadiumId" />

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-semibold small"></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Main Court" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold small"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Capacity" class="form-label fw-semibold small"></label>
                                <input asp-for="Capacity" type="number" min="1" max="1000" class="form-control" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="HourlyPrice" class="form-label fw-semibold small"></label>
                                <input asp-for="HourlyPrice" type="number" min="0" step="0.5" class="form-control" />
                                <span asp-validation-for="HourlyPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="IsIndoor" class="form-check-input" />
                                    <label asp-for="IsIndoor" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand">
                        <i class="bi bi-plus-lg me-1"></i>Add court
                    </button>
                    <a asp-action="Index" asp-route-stadiumId="@Model.StadiumId" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
