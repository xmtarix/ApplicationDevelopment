@using LebanonBasketballReservation.Data.Enums
@model IEnumerable<LebanonBasketballReservation.Business.DTOs.ReservationDto>
@{
    ViewData["Title"] = "Reservations";
    var items = Model.ToList();
    var status = ViewData["Status"] as ReservationStatus?;
    var pendingCount = ViewData["PendingCount"] as int? ?? 0;
}

<div class="container-fluid py-4">
    <h1 class="h4 fw-bold mb-3">
        <i class="bi bi-calendar3 text-brand me-2"></i>Reservations
        @if (pendingCount > 0)
        {
            <span class="badge bg-warning text-dark ms-1">@pendingCount awaiting action</span>
        }
    </h1>

    <ul class="nav nav-pills mb-3 gap-1">
        <li class="nav-item">
            <a class="nav-link @(status is null ? "active" : "")" asp-action="Index">All</a>
        </li>
        @foreach (var st in Enum.GetValues<ReservationStatus>())
        {
            <li class="nav-item">
                <a class="nav-link @(status == st ? "active" : "")"
                   asp-action="Index" asp-route-status="@st">@st</a>
            </li>
        }
    </ul>

    @if (items.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <partial name="_EmptyState" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.EmptyStateModel
                     {
                         Icon = "bi-calendar-x",
                         Title = "No reservations here",
                         Message = "Bookings for your stadiums will appear in this list."
                     })" />
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Stadium / court</th>
                            <th>When</th>
                            <th class="text-end">Price</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@r.CustomerName</div>
                                    <div class="small text-muted">@r.CustomerEmail</div>
                                    @if (!string.IsNullOrEmpty(r.CustomerPhone))
                                    {
                                        <div class="small text-muted">@r.CustomerPhone</div>
                                    }
                                </td>
                                <td class="small">
                                    @r.StadiumName<br /><span class="text-muted">@r.CourtName</span>
                                </td>
                                <td class="small">
                                    @r.Date.ToString("ddd dd MMM")<br />
                                    <span class="text-muted">@r.StartTime.ToString("HH\\:mm") – @r.EndTime.ToString("HH\\:mm")</span>
                                </td>
                                <td class="text-end fw-semibold">$@r.TotalPrice.ToString("N2")</td>
                                <td><partial name="_StatusBadge" model="@r.Status" /></td>
                                <td class="text-end">
                                    @if (r.Status == ReservationStatus.Pending)
                                    {
                                        <div class="d-flex gap-1 justify-content-end">
                                            <form asp-action="Confirm" method="post">
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <button class="btn btn-sm btn-success" title="Confirm">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="collapse" data-bs-target="#reject-@r.Id" title="Reject">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                        <div class="collapse mt-2" id="reject-@r.Id">
                                            <form asp-action="Reject" method="post">
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <div class="input-group input-group-sm">
                                                    <input name="reason" class="form-control"
                                                           placeholder="Reason (optional)" maxlength="500" />
                                                    <button class="btn btn-danger">Reject</button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@r.Id"
                                           class="btn btn-sm btn-outline-secondary">Details</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
