{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=../LebanonBasketball.db"
    },
    "Jwt": {
        "Issuer": "LebanonBasketballReservation",
        "Audience": "LebanonBasketballReservationUsers",
        "ExpiryHours": 24
    },
    "ReservationSettings": {
        "CancellationWindowHours": 24,
        "ReminderHoursBefore": 24,
        "StatusCheckIntervalMinutes": 15,
        "TimeZone": "Asia/Beirut"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
