@model LebanonBasketballReservation.Web.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="text-brand fs-1 mb-2"><i class="bi bi-person-plus"></i></div>
                        <h1 class="h4 fw-bold mb-1">Create your account</h1>
                        <p class="text-muted small mb-0">Book courts across Lebanon in seconds.</p>
                    </div>

                    <form asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                                <input asp-for="FirstName" class="form-control" autocomplete="given-name" autofocus />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="LastName" class="form-label fw-semibold small"></label>
                                <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold small"></label>
                                <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="+961 70 123 456" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label fw-semibold small"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="alert alert-light border small mt-3 mb-3">
                            <i class="bi bi-info-circle me-1 text-brand"></i>
                            Password must be at least 8 characters and include an uppercase letter,
                            a lowercase letter, a number and a symbol.
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="IsManager" class="form-check-input" />
                            <label asp-for="IsManager" class="form-check-label small"></label>
                            <div class="form-text">
                                Stadiums you add are reviewed by an administrator before they go live.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-brand w-100">
                            <i class="bi bi-check2-circle me-1"></i>Create account
                        </button>
                    </form>

                    <p class="text-center text-muted small mt-4 mb-0">
                        Already have an account?
                        <a asp-action="Login" class="text-decoration-none fw-semibold">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
