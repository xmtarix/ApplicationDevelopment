@model LebanonBasketballReservation.Web.ViewModels.Account.ProfileViewModel
@{ ViewData["Title"] = "My profile"; }

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h4 fw-bold mb-4"><i class="bi bi-person-gear text-brand me-2"></i>My profile</h1>

            <form asp-action="Profile" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-semibold">Personal details</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="LastName" class="form-label fw-semibold small"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-semibold small">Email</label>
                                <input class="form-control" value="@Model.Email" disabled readonly />
                                <div class="form-text">Your sign-in email cannot be changed here.</div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="DateOfBirth" class="form-label fw-semibold small"></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            @if (Model.MemberSince != default)
                            {
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold small">Member since</label>
                                    <input class="form-control" value="@Model.MemberSince.ToString("dd MMM yyyy")" disabled readonly />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-semibold">Change password</div>
                    <div class="card-body">
                        <p class="text-muted small">Leave these blank to keep your current password.</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="CurrentPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand">
                        <i class="bi bi-check2 me-1"></i>Save changes
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
