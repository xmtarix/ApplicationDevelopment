@model LebanonBasketballReservation.Web.ViewModels.Account.LoginViewModel
@{ ViewData["Title"] = "Log in"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="text-brand fs-1 mb-2"><i class="bi bi-dribbble"></i></div>
                        <h1 class="h4 fw-bold mb-1">Welcome back</h1>
                        <p class="text-muted small mb-0">Log in to manage your bookings.</p>
                    </div>

                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" autocomplete="username"
                                       placeholder="you@example.com" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small"></label>
                        </div>

                        <button type="submit" class="btn btn-brand w-100">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Log in
                        </button>
                    </form>

                    <p class="text-center text-muted small mt-4 mb-0">
                        New here?
                        <a asp-action="Register" class="text-decoration-none fw-semibold">Create an account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
