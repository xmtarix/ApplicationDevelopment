@model LebanonBasketballReservation.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="display-1 text-brand mb-2"><i class="bi @Model.Icon"></i></div>
            <p class="display-6 fw-bold mb-2">@Model.StatusCode</p>
            <h1 class="h4 fw-semibold mb-3">@Model.Title</h1>
            <p class="text-muted mb-4">@Model.Message</p>

            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand">
                    <i class="bi bi-house me-1"></i>Back to home
                </a>
                <a asp-controller="Stadiums" asp-action="Index" class="btn btn-outline-secondary">
                    Browse stadiums
                </a>
            </div>

            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mt-4 mb-0">
                    Reference: <code>@Model.RequestId</code>
                </p>
            }
        </div>
    </div>
</div>
