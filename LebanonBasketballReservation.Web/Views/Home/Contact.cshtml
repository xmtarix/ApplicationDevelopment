@{ ViewData["Title"] = "Contact"; }
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="fw-bold mb-3">Contact us</h1>
            <p class="lead text-muted mb-4">
                Questions about a booking, or want to list your stadium? Get in touch.
            </p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="text-brand fs-4"><i class="bi bi-envelope"></i></div>
                        <h2 class="h6 fw-semibold mb-1">Email</h2>
                        <a href="mailto:contact@lbbasketball.com" class="text-decoration-none">contact@lbbasketball.com</a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="text-brand fs-4"><i class="bi bi-telephone"></i></div>
                        <h2 class="h6 fw-semibold mb-1">Phone</h2>
                        <a href="tel:+9611000000" class="text-decoration-none">+961 1 000 000</a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="text-brand fs-4"><i class="bi bi-geo-alt"></i></div>
                        <h2 class="h6 fw-semibold mb-1">Office</h2>
                        <p class="mb-0 text-muted small">Hamra Street, Beirut, Lebanon</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100 p-3">
                        <div class="text-brand fs-4"><i class="bi bi-clock"></i></div>
                        <h2 class="h6 fw-semibold mb-1">Support hours</h2>
                        <p class="mb-0 text-muted small">Monday to Saturday, 9:00 – 18:00</p>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-4 mb-0">
                <i class="bi bi-info-circle me-2"></i>
                For questions about a specific booking, include your reservation number so we can help faster.
            </div>
        </div>
    </div>
</div>
