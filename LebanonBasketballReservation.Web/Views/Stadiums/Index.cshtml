@using LebanonBasketballReservation.Data
@using LebanonBasketballReservation.Data.Repositories.Interfaces
@model LebanonBasketballReservation.Web.ViewModels.Stadium.StadiumSearchViewModel
@{
    ViewData["Title"] = "Find stadiums";
    var showFavorites = User.Identity?.IsAuthenticated == true && User.IsInRole(RoleNames.Customer);
    var results = Model.Results;
}

<div class="container-fluid py-4">
    <div class="row g-4">
        <aside class="col-lg-3">
            <div class="card shadow-sm border-0 sticky-lg-top" style="top:5rem">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-funnel me-2"></i>Filters
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold small">Stadium or address</label>
                            <input asp-for="Name" class="form-control form-control-sm" placeholder="Search…" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="GovernorateId" class="form-label fw-semibold small">Governorate</label>
                            <select asp-for="GovernorateId" class="form-select form-select-sm">
                                <option value="">All governorates</option>
                                @foreach (var g in Model.Governorates)
                                {
                                    <option value="@g.Id" selected="@(Model.GovernorateId == g.Id)">@g.Name</option>
                                }
                            </select>
                        </div>

                        @if (Model.Districts.Any())
                        {
                            <div class="mb-3">
                                <label asp-for="DistrictId" class="form-label fw-semibold small">District</label>
                                <select asp-for="DistrictId" class="form-select form-select-sm">
                                    <option value="">All districts</option>
                                    @foreach (var d in Model.Districts)
                                    {
                                        <option value="@d.Id" selected="@(Model.DistrictId == d.Id)">@d.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        @if (Model.Areas.Any())
                        {
                            <div class="mb-3">
                                <label asp-for="AreaId" class="form-label fw-semibold small">Area</label>
                                <select asp-for="AreaId" class="form-select form-select-sm">
                                    <option value="">All areas</option>
                                    @foreach (var a in Model.Areas)
                                    {
                                        <option value="@a.Id" selected="@(Model.AreaId == a.Id)">@a.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="IsIndoor" class="form-label fw-semibold small">Court type</label>
                            <select asp-for="IsIndoor" class="form-select form-select-sm">
                                <option value="">Indoor or outdoor</option>
                                <option value="true" selected="@(Model.IsIndoor == true)">Indoor only</option>
                                <option value="false" selected="@(Model.IsIndoor == false)">Outdoor only</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Price per hour ($)</label>
                            <div class="row g-2">
                                <div class="col">
                                    <input asp-for="MinPrice" type="number" min="0" step="5"
                                           class="form-control form-control-sm" placeholder="Min" />
                                </div>
                                <div class="col">
                                    <input asp-for="MaxPrice" type="number" min="0" step="5"
                                           class="form-control form-control-sm" placeholder="Max" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SortBy" class="form-label fw-semibold small">Sort by</label>
                            <select asp-for="SortBy" class="form-select form-select-sm"
                                    asp-items="Html.GetEnumSelectList<StadiumSortOrder>()"></select>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 btn-sm">
                            <i class="bi bi-search me-1"></i>Apply filters
                        </button>

                        @if (Model.HasFilters)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm mt-2">
                                Clear all
                            </a>
                        }
                    </form>
                </div>
            </div>
        </aside>

        <div class="col-lg-9">
            @if (results is not null)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h1 class="h5 mb-0">
                        @results.TotalCount stadium@(results.TotalCount == 1 ? "" : "s") found
                        @if (results.TotalCount > 0)
                        {
                            <span class="text-muted fw-normal small">
                                (showing @results.FirstItemIndex–@results.LastItemIndex)
                            </span>
                        }
                    </h1>
                </div>

                @if (results.Items.Count == 0)
                {
                    <div class="card border-0 shadow-sm">
                        <partial name="_EmptyState" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.EmptyStateModel
                                 {
                                     Icon = "bi-search",
                                     Title = "No stadiums match those filters",
                                     Message = "Try widening your price range or choosing a different location.",
                                     ActionText = Model.HasFilters ? "Clear filters" : null,
                                     ActionUrl = Model.HasFilters ? Url.Action("Index") : null
                                 })" />
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var s in results.Items)
                        {
                            <div class="col-sm-6 col-xl-4">
                                <partial name="_StadiumCard" model="@(new LebanonBasketballReservation.Web.ViewModels.Stadium.StadiumCardModel
                                         {
                                             Stadium = s,
                                             ShowFavorite = showFavorites,
                                             IsFavorite = Model.FavoriteIds.Contains(s.Id),
                                             ReturnUrl = Context.Request.Path + Context.Request.QueryString
                                         })" />
                            </div>
                        }
                    </div>

                    <partial name="_Pager" model="@(new LebanonBasketballReservation.Web.ViewModels.Shared.PagerModel
                             {
                                 Page = results.Page,
                                 TotalPages = results.TotalPages,
                                 RouteValues = Model.RouteValues(),
                                 PageParameterName = "Page"
                             })" />
                }
            }
        </div>
    </div>
</div>
